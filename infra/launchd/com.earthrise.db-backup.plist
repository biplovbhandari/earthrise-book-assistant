<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: edit the paths below before loading.
  Replace REPO_PATH with your clone location (e.g. /Users/yourname/earthrise-book-assistant).
  Replace HOMEBREW_PREFIX with /opt/homebrew (Apple Silicon) or /usr/local (Intel).
  Replace DOCKER_BIN with the output of: dirname $(which docker)
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.earthrise.db-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>HOMEBREW_PREFIX/bin/just</string>
        <string>db-backup</string>
    </array>

    <key>WorkingDirectory</key>
    <string>REPO_PATH</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>REPO_PATH/backups/backup.log</string>

    <key>StandardErrorPath</key>
    <string>REPO_PATH/backups/backup.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>HOMEBREW_PREFIX/bin:DOCKER_BIN:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
