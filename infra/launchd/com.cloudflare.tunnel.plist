<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template: edit the paths below before loading.
  Replace REPO_PATH with your clone location (e.g. /Users/yourname/earthrise-book-assistant).
  Replace HOMEBREW_PREFIX with /opt/homebrew (Apple Silicon) or /usr/local (Intel).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cloudflare.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>HOMEBREW_PREFIX/bin/cloudflared</string>
        <string>tunnel</string>
        <string>run</string>
        <string>earthrise</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>REPO_PATH/logs/tunnel.log</string>

    <key>StandardErrorPath</key>
    <string>REPO_PATH/logs/tunnel.error.log</string>
</dict>
</plist>
